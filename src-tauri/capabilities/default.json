{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimum capability set for Echo's main window. Everything Echo does goes through its own typed commands; no broad filesystem or shell access is granted to the webview.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:event:default",
    "core:app:default",
    "notification:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-confirm",
    "log:default",
    "opener:allow-open-url"
  ]
}
